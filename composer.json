{
    "name": "dehy/musicbrainz",
    "type": "library",
    "description": "A PHP library for accessing the MusicBrainz API",
    "keywords": ["musicbrainz", "library", "php", "api"],
    "homepage": "https://github.com/dehy/musicbrainz",
    "license": "MIT",
    "authors": [
        {
            "name": "Mike Almond",
            "email": "mike.almond@gmail.com",
            "homepage": "http://mikealmond.com",
            "role": "Developer"
        },
        {
            "name": "Arnaud de Mouhy",
            "email": "arnaud@admds.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Allows you to use the GuzzleHttpAdapter. You must install one of the supported adapters."
    },
    "autoload": {
        "psr-4": {
            "MusicBrainz\\": "src/",
            "MusicBrainz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "lint": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.3.x-dev"
        }
    }
}
